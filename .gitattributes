# Keep line endings predictable regardless of who clones this.
#
# Everything is stored as LF in the repo. Windows working copies still get
# CRLF locally, which is why git warns on `add` - that warning is the
# system working, not a problem. Storing LF matters because the Docker
# image and CI both run on Linux.

* text=auto eol=lf

# Windows-only files that genuinely want CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binaries - never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.db   binary
