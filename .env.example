# Copy to .env and fill in. Only SESSION_SECRET is required to run.

# Any long random string. Changing it signs everyone out.
SESSION_SECRET=change-me-to-something-long-and-random

PORT=3000

# Where the SQLite file lives (relative paths resolve from the project root).
DATABASE_FILE=./data/coachdesk.db

# --- Google Calendar sync (optional) ---------------------------------
# Leave blank and the app runs fine — the sync panel just explains what's missing.
#
# To enable:
#   1. console.cloud.google.com -> create a project
#   2. Enable the "Google Calendar API"
#   3. Credentials -> Create OAuth client ID -> Web application
#   4. Add this exact redirect URI:  http://localhost:3000/api/google/callback
#   5. Paste the client ID and secret below
#
# While your OAuth consent screen is in "Testing", only accounts you add
# as test users can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Set to "production" behind HTTPS so session cookies get the Secure flag.
NODE_ENV=development

# Public URL used to build password-reset links. Leave blank for local dev
# and it's inferred from the request. Set it explicitly behind a proxy.
APP_URL=

# --- Email for password resets (optional) -----------------------------
# Leave SMTP_HOST blank and reset links print to the server console instead,
# which is enough to test the whole flow locally.
#
# Gmail example (requires an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=CoachDesk <you@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- AI parsing fallback (optional) -----------------------------------
# The built-in rules handle ordinary phrasing offline, instantly and free.
# Add a key here and anything the rules can't work out gets passed to
# Claude instead of showing "not quite" — only the leftovers cost anything.
#
# Get a key at console.anthropic.com. Leave blank to stay rules-only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Public demo (optional) -------------------------------------------
# Adds a "Try the demo" button that signs visitors into a pre-populated
# workspace with no signup. The data resets on every demo sign-in, so
# nobody inherits the previous visitor's edits.
# Worth turning on for a portfolio deployment; leave off for real use.
PUBLIC_DEMO=false
DEMO_EMAIL=demo@coachdesk.app

# Set true on hosting with no persistent disk (e.g. Render's free tier).
# Shows a banner warning that data resets, instead of silently losing it.
EPHEMERAL_STORAGE=false
