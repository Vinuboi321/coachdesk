{
  "name": "coachdesk",
  "version": "0.2.0",
  "private": true,
  "description": "Voice-driven client and scheduling manager for coaches.",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:static": "node scripts/build-static.js",
    "test": "node test/parser.test.js && node test/sync.test.js && npm run test:static",
    "test:parser": "node test/parser.test.js",
    "test:sync": "node test/sync.test.js",
    "test:static": "node scripts/build-static.js && node test/static.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
